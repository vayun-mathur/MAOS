<ExternalCamera>
    <Provider>
        <!-- Ignored /dev/videoN. The id is the numeric suffix of the node name as a
             string (ExternalCameraProvider.cpp deviceAdded/inotify paths), NOT the minor
             number. On shiba 6-11 are the MFC codec nodes (mediacodec:mediadrm, so the
             HAL gets EACCES) and 12 is the JPEG device (labelled hw_jpg_device, which
             hal_camera has no rule for, so it gets an avc denial). Names 0-5 are free,
             which is where a hot-plugged UVC camera lands - and 0-3 are the only nodes
             /vendor/etc/ueventd.rc chowns to system:camera. -->
        <ignore>
            <id>6</id>
            <id>7</id>
            <id>8</id>
            <id>9</id>
            <id>10</id>
            <id>11</id>
            <id>12</id>
        </ignore>
    </Provider>
    <Device>
        <MaxJpegBufferSize bytes="3145728"/>
        <NumVideoBuffers count="4"/>
        <NumStillBuffers count="2"/>
        <!-- Each fpsBound is an inclusive upper-bound FILTER, not a target: any rate the
             camera advertises above it is discarded, and a size whose rates are ALL
             discarded is dropped from the supported-format list entirely
             (ExternalCameraDevice::updateFpsBounds). So a bound that is too low removes
             the resolution rather than slowing it down. The last entry also caps the
             maximum supported size.

             Sizes must strictly increase and fpsBound must strictly decrease
             (ExternalCameraConfig::updateFpsList) - a violation rejects the whole list
             AND abandons the rest of this file, silently reverting to the built-in
             defaults of 720p@7.5 / 1080p@5. Hence 60/45/30 rather than a flat 30: it
             admits 30fps at every size while satisfying the ordering rule.

             1080p is the cap because MJPEG is decoded in software on the CPU
             (libyuv::MJPGToI420 in ExternalCameraDeviceSession). -->
        <FpsList>
            <Limit width="640"  height="480"  fpsBound="60.0"/>
            <Limit width="1280" height="720"  fpsBound="45.0"/>
            <Limit width="1920" height="1080" fpsBound="30.0"/>
        </FpsList>
    </Device>
</ExternalCamera>
