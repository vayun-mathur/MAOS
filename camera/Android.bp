// VINTF declaration for the AOSP external (USB/UVC) camera provider.
//
// cameraserver discovers camera providers ONLY through
// ServiceManager::getDeclaredInstances (CameraProviderManager::tryToAddAidlProvidersLocked),
// so shipping the binary without this fragment produces a running service nobody talks to.
//
// This is a standalone fragment rather than a DEVICE_MANIFEST_FILE entry so that nothing in
// the base /vendor/etc/vintf/manifest.xml is modified or reordered. shiba's own vendor
// manifest declares no camera HAL at all - internal/0 comes from the
// com.google.pixel.camera.hal APEX - so this adds an instance and displaces nothing.
//
// soc_specific installs to /vendor/etc/vintf/manifest/, matching adevtool's 39 fragments.
// The installed filename is the src basename, not the module name (vintf_fragment.go).
vintf_fragment {
    name: "maos_vintf_fragment_camera_provider_external",
    src: "android.hardware.camera.provider-V1-external-service.xml",
    soc_specific: true,
}
