<?xml version="1.0" encoding="utf-8"?>
<!-- MAOS framework-res overrides, shipped as an explicit static, platform-signed RRO
     (module MaosFrameworkResRRO). Moved here from the former
     overlay/frameworks/base/core/res/res/values/config.xml so PRODUCT_PACKAGE_OVERLAYS no
     longer generates an auto-generated framework-res RRO that collides with adevtool's prebuilt.
     framework-res.apk itself stays unmodified. -->
<resources>
    <!-- Default browser role -> Modern Apps Web.
         Vanadium remains installed as the system WebView provider; this only changes
         which app holds the browser role. -->
    <string name="config_defaultBrowser" translatable="false">com.vayunmathur.web</string>

    <!-- Storage Access Framework / documents UI host -> Modern Apps Files.
         Replaces com.android.documentsui. The Files app must ship a system build variant
         that registers the SAF picker intents and holds MANAGE_DOCUMENTS (allowlisted in
         privapp-permissions-modern-apps.xml). -->
    <string name="config_documentsUiPackage" translatable="false">com.vayunmathur.files</string>

    <!-- Default speech recognition (STT) -> Modern Apps Speech (Whisper, on-device).
         AOSP ships no default recognizer; this makes SpeechRecognizer work offline. -->
    <string name="config_defaultSpeechRecognitionService" translatable="false">com.vayunmathur.speech/.service.WhisperRecognitionService</string>
    <string name="config_defaultOnDeviceSpeechRecognitionService" translatable="false">com.vayunmathur.speech/.service.WhisperRecognitionService</string>
    <!-- TTS: Modern Apps Speech (Piper) is the only installed engine, so the framework
         selects it as the default TTS engine automatically; no dedicated config exists. -->

    <!-- Default dialer role -> Modern Apps Communicate. Replaces GrapheneOS's Dialer
         (com.android.dialer), removed in modern_apps.mk. Communicate declares an InCallService
         and holds the DIALER role. -->
    <string name="config_defaultDialer" translatable="false">com.vayunmathur.communicate</string>

    <!-- Default SMS/MMS app role -> Modern Apps Communicate. Replaces GrapheneOS's Messaging
         (com.android.messaging), removed in modern_apps.mk. Communicate declares the
         SMS_DELIVER / WAP_PUSH_DELIVER receivers and holds the SMS role; the role system
         auto-grants its SMS/Phone/Contacts runtime permissions. -->
    <string name="config_defaultSms" translatable="false">com.vayunmathur.communicate</string>

    <!-- Offline geocoder -> Modern Apps NetworkLocation. Its GeocodeService (bound via the
         com.android.location.service.GeocodeProvider action) becomes THE system geocoder.
         Replaces GrapheneOS's NetworkLocation module (removed in modern_apps.mk). -->
    <string name="config_geocoderProviderPackageName" translatable="false">com.vayunmathur.networklocation</string>

    <!-- Network location provider -> Modern Apps NetworkLocation. Its NetworkLocationService
         (bound via the com.android.location.service.v3.NetworkLocationProvider action) becomes
         THE system network location provider, replacing GrapheneOS's NetworkLocation module. -->
    <string name="config_networkLocationProviderPackageName" translatable="false">com.vayunmathur.networklocation</string>

    <!-- The two config_*ProviderPackageName pins above are ONLY honored when these overlay
         bools are false. They default to TRUE in AOSP, in which case the framework ignores the
         explicit package name and instead signature-matches candidate providers against the
         platform key (picking the highest version). Our app is presigned with the com.vayunmathur
         key, not the platform key, so it would never be selected. Force the explicit-pin path. -->
    <bool name="config_enableNetworkLocationOverlay">false</bool>
    <bool name="config_enableGeocoderOverlay">false</bool>

    <!-- Default app-data backup transport -> Modern Apps Backup. Replaces GrapheneOS's
         Seedvault (com.stevesoltys.seedvault) and the GrapheneOS contacts backup transport
         (app.grapheneos.backup.contacts), both removed in modern_apps.mk. This is the AOSP
         framework default-transport pin (a "package/service" component); Backup holds the
         signature|privileged BACKUP permission (allowlisted in
         privapp-permissions-modern-apps.xml) so the BackupManagerService will bind it. -->
    <string name="config_backup_transport" translatable="false">com.vayunmathur.backup/.transport.ConfigurableBackupTransportService</string>
</resources>
