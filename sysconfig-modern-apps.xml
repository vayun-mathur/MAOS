<?xml version="1.0" encoding="utf-8"?>
<!--
  Sysconfig for Modern Apps headless system services.
  Copied to /product/etc/sysconfig/ by modern_apps.mk.

  NetworkLocation (com.vayunmathur.networklocation) replaces GrapheneOS's NetworkLocation
  module and must keep running in the background to service location/geocoder requests. These
  entries mirror GrapheneOS's own networklocation sysconfig so the app is:
    - allow-in-power-save        exempt from Doze app-standby (runs during idle windows)
    - allow-in-data-usage-save   exempt from Data Saver background-data restrictions
    - allow-unthrottled-location exempt from the background location throttle

  Backup (com.vayunmathur.backup) is the system app-data backup transport, replacing Seedvault.
  A transport is only bindable if its service is named here: BackupManagerService reads this
  allowlist through SystemConfig.getBackupTransportWhitelist() and refuses to bind anything
  absent from it, so config_backup_transport alone is not enough to select ours. Mirrors
  Seedvault's own allowlist_com.stevesoltys.seedvault.xml, including the Doze exemption its
  file-backup foreground service needs to start from the background.
-->
<config>
    <allow-in-power-save package="com.vayunmathur.networklocation" />
    <allow-in-data-usage-save package="com.vayunmathur.networklocation" />
    <allow-unthrottled-location package="com.vayunmathur.networklocation" />


    <backup-transport-whitelisted-service
        service="com.vayunmathur.backup/.service.ConfigurableBackupTransportService" />
    <allow-in-power-save package="com.vayunmathur.backup" />

    <!-- Cast reaches VirtualDisplayConfig.Builder.setSupportedModes() and setUniqueId() by
         reflection: the first declares the TV's resolutions on the cast display so Android's
         external-display resolution picker offers them, the second gives the display a stable
         unique id. Both are @SystemApi, so hidden-API enforcement blocks the reflection for a
         presigned (non-platform-signed) app and the modes never reach the picker. Exempt the
         package. ALLOW_HIDDENAPI_WHITELISTING is granted to the product partition
         (SystemConfig.java), so this is honoured from /product/etc/sysconfig. -->
    <hidden-api-whitelisted-app package="com.vayunmathur.cast" />

    <!-- Parental Controls reaches UsageStatsManager.registerAppUsageLimitObserver and its unregister
         counterpart by reflection. Both are @SystemApi members of an ordinary public class, so a
         compileOnly stub is the wrong shape - it would shadow the real UsageStatsManager for
         every other caller in the app - and reflection is what the repo uses for that case (see
         logviewer's HiddenFrameworkApi). Hidden-API enforcement blocks that for a presigned,
         non-platform-signed app, exactly as it does for cast above.

         Only the reflection needs this. The SupervisionManager and SupervisionAppService calls
         are direct, through library/supervision-stubs, and link without an exemption.

         UsageStatsService still applies its own permission check on the other side; it passes
         only because we hold the supervision role. The exemption buys visibility, not privilege. -->
    <hidden-api-whitelisted-app package="com.vayunmathur.parentalcontrols" />
    <hidden-api-whitelisted-app package="com.vayunmathur.screentime" />
    <!-- Emergency (com.vayunmathur.emergency) replaces AOSP EmergencyInfo. The SOS
         countdown runs as a foreground service off an exact alarm; exempt it from Doze
         like stock does so the countdown is not killed while the screen is off. -->
    <allow-in-power-save package="com.vayunmathur.emergency" />

</config>
