<?xml version="1.0" encoding="utf-8"?>
<!--
  Privileged-permission allowlist for Modern Apps priv-apps.
  Copied to /product/etc/permissions/ by modern_apps.mk. Without this entry the build
  (and boot) rejects a priv-app that requests a signature|privileged permission.
-->
<permissions>
    <!-- Files takes over DocumentsUI's Storage Access Framework role in the system build,
         which requires the signature|privileged MANAGE_DOCUMENTS permission. -->
    <privapp-permissions package="com.vayunmathur.files">
        <permission name="android.permission.MANAGE_DOCUMENTS" />
    </privapp-permissions>

    <!-- NOTE: MANAGE_EXTERNAL_STORAGE (all-files access), if Files needs it, is a special
         app-op permission granted via role/appops, NOT a privapp-permission — do not add
         it here. -->

    <!-- NetworkLocation is a priv-app providing the system network location provider and
         geocoder (pinned via config_networkLocationProviderPackageName /
         config_geocoderProviderPackageName). It requires these signature|privileged perms. -->
    <privapp-permissions package="com.vayunmathur.networklocation">
        <permission name="android.permission.INSTALL_LOCATION_PROVIDER" />
        <permission name="android.permission.LOCATION_HARDWARE" />
        <permission name="android.permission.MODIFY_PHONE_STATE" />
        <permission name="android.permission.UPDATE_DEVICE_STATS" />
    </privapp-permissions>

    <!-- Euicc is the system eSIM LPA (declares EuiccService). Managing embedded subscriptions
         and driving the eUICC over a telephony logical channel requires these signature|privileged
         perms. Replaces Google's EuiccGoogle LPA; the EuiccSupportPixel hardware backend is kept. -->
    <privapp-permissions package="com.vayunmathur.euicc">
        <permission name="android.permission.WRITE_EMBEDDED_SUBSCRIPTIONS" />
        <permission name="android.permission.MODIFY_PHONE_STATE" />
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    </privapp-permissions>

    <!-- Backup is the system app-data backup transport (declares BackupTransport via a
         TRANSPORT_HOST service). Acting as a transport requires the signature|privileged
         BACKUP permission; activating itself as the current transport requires
         WRITE_SECURE_SETTINGS. Replaces GrapheneOS's Seedvault; pinned as the default
         transport via config_backup_transport. -->
    <privapp-permissions package="com.vayunmathur.backup">
        <permission name="android.permission.BACKUP" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>
</permissions>
