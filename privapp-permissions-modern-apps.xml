<?xml version="1.0" encoding="utf-8"?>
<!--
  Privileged-permission allowlist for Modern Apps priv-apps.
  Copied to /product/etc/permissions/ by modern_apps.mk. Without this entry the build
  (and boot) rejects a priv-app that requests a signature|privileged permission.
-->
<permissions>
    <!-- Files takes over DocumentsUI's Storage Access Framework role in the system build,
         which requires the signature|privileged MANAGE_DOCUMENTS permission. -->
    <privapp-permissions package="com.vayunmathur.files">
        <permission name="android.permission.MANAGE_DOCUMENTS" />
    </privapp-permissions>

    <!-- NOTE: MANAGE_EXTERNAL_STORAGE (all-files access), if Files needs it, is a special
         app-op permission granted via role/appops, NOT a privapp-permission — do not add
         it here. -->

    <!-- NetworkLocation is a priv-app providing the system network location provider and
         geocoder (pinned via config_networkLocationProviderPackageName /
         config_geocoderProviderPackageName). It requires these signature|privileged perms. -->
    <privapp-permissions package="com.vayunmathur.networklocation">
        <permission name="android.permission.INSTALL_LOCATION_PROVIDER" />
        <permission name="android.permission.LOCATION_HARDWARE" />
        <permission name="android.permission.MODIFY_PHONE_STATE" />
        <permission name="android.permission.UPDATE_DEVICE_STATS" />
    </privapp-permissions>

    <!-- Euicc is the system eSIM LPA (declares EuiccService). Managing embedded subscriptions
         and driving the eUICC over a telephony logical channel requires these signature|privileged
         perms. Replaces Google's EuiccGoogle LPA; the EuiccSupportPixel hardware backend is kept. -->
    <privapp-permissions package="com.vayunmathur.euicc">
        <permission name="android.permission.WRITE_EMBEDDED_SUBSCRIPTIONS" />
        <permission name="android.permission.MODIFY_PHONE_STATE" />
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    </privapp-permissions>

    <!-- Backup is the system app-data backup transport (declares BackupTransport via a
         TRANSPORT_HOST service). Acting as a transport requires the signature|privileged
         BACKUP permission; activating itself as the current transport requires
         WRITE_SECURE_SETTINGS. Replaces GrapheneOS's Seedvault; pinned as the default
         transport via config_backup_transport. -->
    <privapp-permissions package="com.vayunmathur.backup">
        <permission name="android.permission.BACKUP" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>
    <!-- Cast is PRIVILEGED: it is a remote display provider, which is what puts its receivers in
         Settings' Cast page. RemoteDisplayProviderWatcher.verifyServiceTrusted only trusts a
         provider whose app holds REMOTE_DISPLAY_PROVIDER (signature|privileged); without it the
         watcher logs and skips the service and the page is simply empty.
         START_ACTIVITIES_FROM_BACKGROUND (signature|privileged|vendorPrivileged|oem|verifier|role)
         is needed because selecting a route ends at the screen-capture consent activity, launched
         from a bound service while Settings is in front. CAPTURE_VIDEO_OUTPUT would avoid the
         consent activity entirely but is signature-only, so it is unreachable for a presigned app.
         The package attribute below must byte-match the installed package
         (cast/build.gradle.kts applicationId). With ro.control_privapp_permissions=enforce a
         mismatch is not a warning - the device does not boot.
         The TV receiver (com.vayunmathur.cast.tv) is deliberately absent: it is not preinstalled. -->
    <privapp-permissions package="com.vayunmathur.cast">
        <permission name="android.permission.REMOTE_DISPLAY_PROVIDER" />
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
            <!-- Desktop-mode audio via MediaRecorder.AudioSource.REMOTE_SUBMIX. The
             projection-scoped capture used by screen mirroring is unavailable on that
             path because it deliberately holds no MediaProjection. -->
        <permission name="android.permission.CAPTURE_AUDIO_OUTPUT"/>
</privapp-permissions>

    <!-- SetupWizard is PRIVILEGED: it is the first-run setup wizard, selected by the platform
         as the HOME activity (MAIN + SETUP_WIZARD + HOME at priority 999) while the device is
         unprovisioned. It sets the system locale, the clock, the time zone and the location
         master switch, reads and clears the OEM-unlock state, disables the status bar for the
         duration, and writes DEVICE_PROVISIONED / user_setup_complete to end setup - all of
         which are signature|privileged. It replaces GrapheneOS's SetupWizard2
         (app.grapheneos.setupwizard); that module and AOSP's fallback Provision are both
         dropped by `overrides` on ModernAppsSetupWizard in Android.bp.

         The package attribute below must byte-match the installed package
         (setupwizard/build.gradle.kts applicationId). With
         ro.control_privapp_permissions=enforce a mismatch is not a warning - the device does
         not boot past setup.

         This is GrapheneOS's etc/permissions/app.grapheneos.setupwizard.xml minus
         com.stevesoltys.seedvault.RESTORE_BACKUP, which is gone with Seedvault.
         SET_TIME / SET_TIME_ZONE ARE PENDING REMOVAL AND MUST NOT BE REMOVED YET. Source
         stopped using them when the manual date-and-time step was replaced by the automatic
         clock (a Settings.Global write, covered by WRITE_SECURE_SETTINGS below, not by
         SET_TIME), and the app manifest no longer requests them - but the STAGED PREBUILT
         still does, and this allowlist is matched against the installed APK, not against
         source. Removing them before the prebuilt is rebuilt is the boot-fatal direction.
         Sequence: rebuild + re-stage the APK, confirm with
         analysis/probe_setupwizard_apk_perms.py, then run
         analysis/setupwizard_drop_time_perms.py.
         ACCESS_WIFI_STATE (normal) and app.seamlessupdate.client.OPEN_SECURITY_PREVIEW_SETTINGS
         (declared by the updater, not the platform) are in the app manifest and correctly not
         allowlisted here, matching upstream. -->
    <privapp-permissions package="com.vayunmathur.setupwizard">
        <permission name="android.permission.CHANGE_CONFIGURATION" />
        <permission name="android.permission.MANAGE_USER_OEM_UNLOCK_STATE" />
        <permission name="android.permission.NETWORK_SETUP_WIZARD" />
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
        <permission name="android.permission.READ_OEM_UNLOCK_STATE" />
        <permission name="android.permission.REBOOT" />
        <permission name="android.permission.SET_TIME" />
        <permission name="android.permission.SET_TIME_ZONE" />
        <permission name="android.permission.STATUS_BAR" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="android.permission.WRITE_SETTINGS" />
    </privapp-permissions>

    <privapp-permissions package="com.vayunmathur.logviewer">
        <permission name="android.permission.READ_LOGS"/>
        <permission name="android.permission.READ_LOGS_FULL"/>
        <permission name="android.permission.READ_OEM_UNLOCK_STATE"/>
        <permission name="android.permission.QUERY_USERS"/>
    </privapp-permissions>

    <privapp-permissions package="com.vayunmathur.updater">
        <!-- Reboot into the slot update_engine just wrote. -->
        <permission name="android.permission.REBOOT"/>
        <!-- update_engine stages payload metadata under /cache. -->
        <permission name="android.permission.ACCESS_CACHE_FILESYSTEM"/>
        <!-- Evict cached data to make room for a 1-2 GB package. -->
        <permission name="android.permission.ALLOCATE_AGGRESSIVE"/>
    </privapp-permissions>

</permissions>
