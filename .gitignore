# Prebuilt APKs are large binaries populated at build time by scripts/collect-apks.sh.
# They are reproducible from the Modern-Apps repo, so we don't commit them.
prebuilts/*.apk

# Private signing keys. NEVER commit these. generate-keys.sh writes them here or to an
# out-of-tree dir; this guards against an accidental in-repo generation.
keys/*.pk8
keys/*.pem
keys/*.x509.pem
keys/*.bin
*.keystore
*.jks

# Python bytecode
__pycache__/
*.pyc
