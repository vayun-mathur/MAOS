+# MAOS: progress reporting. progress_bar TOTAL PATTERN CMD... runs CMD, counts output
+# lines matching PATTERN, and redraws a single [####----] N/TOTAL line on stderr while
+# passing all output through (nothing hidden).
+progress_bar() {
+    local total="$1" pattern="$2"; shift 2
+    "$@" 2>&1 | awk -v total="$total" -v pat="$pattern" '
+        { print > "/dev/stderr"; fflush("/dev/stderr") }
+        $0 ~ pat {
+            n++; pct = int(50 * n / total); if (pct > 50) pct = 50;
+            bar = sprintf("%*s", pct, ""); gsub(/ /, "#", bar);
+            pad = sprintf("%*s", 50 - pct, ""); gsub(/ /, "-", pad);
+            printf "\r  [MAOS] [%s%s] %d/%d", bar, pad, n, total > "/dev/stderr";
+        }
+        END { printf "\n" > "/dev/stderr" }'
+}
+count_signables() {
+    unzip -l "$1" 2>/dev/null | grep -cE "\.(apk|apex)$"
+}
+
+# MAOS: stage logging + optional OTA skip. SKIP_OTA=1 skips ota_from_target_files +
+# generate-metadata (saves ~15-20 min) for local flash-test builds; the install/factory
+# images are unaffected. Default (unset/empty) builds everything as upstream.
+stage() { echo ""; echo "===== [generate-release] STAGE $1/4: $2 ($(date -u +%H:%M:%S)) ====="; }
+
