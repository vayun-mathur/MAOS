diff --git a/src/com/android/settings/security/MaosAttestationClient.java b/src/com/android/settings/security/MaosAttestationClient.java
new file mode 100644
index 00000000000..2b83d1bc9e1
--- /dev/null
+++ b/src/com/android/settings/security/MaosAttestationClient.java
@@ -0,0 +1,199 @@
+/*
+ * MAOS device attestation client (one-time, the Auditor model).
+ *
+ * One-off, user-triggered only: nothing here runs on a schedule, at boot,
+ * or in the background. When the user taps "Verify" this client asks the
+ * server for a fresh single-use challenge, generates a hardware-backed
+ * key with that challenge (StrongBox where available, TEE otherwise), and
+ * sends the resulting certificate chain to the server in a single submit.
+ * There is no enrollment and no device identity: every Verify is a fresh
+ * one-shot attestation. The server verifies the chain up to Google's
+ * hardware attestation root, checks the challenge is fresh, and checks
+ * the RootOfTrust says Verified with the device locked. Any device with
+ * valid hardware evidence gets a verdict — no approval is needed or
+ * involved.
+ *
+ * The verdict, code and URL shown in Settings are the server's response,
+ * never a local self-assessment. All attestation claims come from the
+ * certificate chain, not from Build properties or any other OS-reported
+ * value (a compromised OS could lie about those).
+ */
+package com.android.settings.security;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.security.keystore.KeyGenParameterSpec;
+import android.security.keystore.KeyProperties;
+import android.util.Base64;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.BufferedReader;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.security.KeyPairGenerator;
+import java.security.KeyStore;
+import java.security.cert.Certificate;
+import java.security.spec.ECGenParameterSpec;
+
+final class MaosAttestationClient {
+
+    static final String PREFS = "maos_attestation";
+    static final String KEY_LAST_RESULT = "last_result";
+    static final String KEY_LAST_AT = "last_at";
+    static final String KEY_LAST_LEVEL = "last_level";
+    static final String KEY_LAST_CODE = "last_code";
+    static final String KEY_LAST_URL = "last_url";
+
+    private static final String BASE = "https://api.maproj.org/attest/v1";
+    private static final String FRESH_ALIAS = "maos_attestation_fresh";
+
+    private final SharedPreferences mPrefs;
+
+    MaosAttestationClient(Context context) {
+        mPrefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    static final class Result {
+        final boolean pass;
+        final String reason;
+        final String securityLevel;
+        final String userCode;
+        final String verifyUrl;
+
+        Result(boolean pass, String reason, String securityLevel, String userCode,
+                String verifyUrl) {
+            this.pass = pass;
+            this.reason = reason;
+            this.securityLevel = securityLevel;
+            this.userCode = userCode;
+            this.verifyUrl = verifyUrl;
+        }
+    }
+
+    /** Run one one-shot verification round-trip. Blocking; call off the main thread. */
+    Result verifyNow() throws Exception {
+        JSONObject challenge = post("/challenge", new JSONObject());
+        byte[] nonce = hexToBytes(challenge.getString("nonce"));
+        boolean strongBox = generateKey(FRESH_ALIAS, nonce, true);
+        JSONObject resp = post("/submit",
+                new JSONObject().put("chain", chainJson(FRESH_ALIAS)));
+        return record(resp, strongBox);
+    }
+
+    private Result record(JSONObject resp, boolean strongBoxRequested) throws Exception {
+        boolean pass = resp.optBoolean("pass", false);
+        String reason = resp.optString("reason", pass ? "ok" : "unknown");
+        // The security level that counts is the one the server read from
+        // the verified chain; the local StrongBox label is only a hint for
+        // the (pre-verdict) case where the server did not answer.
+        String level = resp.optString("security_level",
+                strongBoxRequested ? "StrongBox" : "TrustedEnvironment");
+        String userCode = resp.optString("userCode", "");
+        String verifyUrl = resp.optString("verifyUrl", "");
+        mPrefs.edit()
+                .putString(KEY_LAST_RESULT, pass ? "pass" : "fail: " + reason)
+                .putLong(KEY_LAST_AT, System.currentTimeMillis())
+                .putString(KEY_LAST_LEVEL, level)
+                .putString(KEY_LAST_CODE, userCode)
+                .putString(KEY_LAST_URL, verifyUrl)
+                .apply();
+        return new Result(pass, reason, level, userCode, verifyUrl);
+    }
+
+    /**
+     * Generate (or replace) a hardware EC P-256 signing key attested with
+     * {@code challenge}. Tries StrongBox first; on failure retries with the
+     * TEE and returns false so the UI can label the level honestly (the
+     * server's verdict still carries the authoritative level from the
+     * chain).
+     */
+    private boolean generateKey(String alias, byte[] challenge, boolean tryStrongBox)
+            throws Exception {
+        try {
+            buildKey(alias, challenge, tryStrongBox);
+            return tryStrongBox;
+        } catch (Exception e) {
+            if (!tryStrongBox) {
+                throw e;
+            }
+            buildKey(alias, challenge, false);
+            return false;
+        }
+    }
+
+    private void buildKey(String alias, byte[] challenge, boolean strongBox)
+            throws Exception {
+        KeyPairGenerator gen = KeyPairGenerator.getInstance(
+                KeyProperties.KEY_ALGORITHM_EC, "AndroidKeyStore");
+        KeyGenParameterSpec.Builder builder = new KeyGenParameterSpec.Builder(
+                alias, KeyProperties.PURPOSE_SIGN)
+                .setAlgorithmParameterSpec(new ECGenParameterSpec("secp256r1"))
+                .setDigests(KeyProperties.DIGEST_SHA256)
+                .setAttestationChallenge(challenge);
+        if (strongBox) {
+            builder.setIsStrongBoxBacked(true);
+        }
+        gen.initialize(builder.build());
+        gen.generateKeyPair();
+    }
+
+    private JSONArray chainJson(String alias) throws Exception {
+        KeyStore ks = KeyStore.getInstance("AndroidKeyStore");
+        ks.load(null);
+        Certificate[] chain = ks.getCertificateChain(alias);
+        if (chain == null || chain.length == 0) {
+            throw new IllegalStateException("no certificate chain for " + alias);
+        }
+        JSONArray out = new JSONArray();
+        for (Certificate cert : chain) {
+            out.put(Base64.encodeToString(cert.getEncoded(), Base64.NO_WRAP));
+        }
+        return out;
+    }
+
+    private JSONObject post(String path, JSONObject body) throws Exception {
+        HttpURLConnection conn = (HttpURLConnection) new URL(BASE + path).openConnection();
+        conn.setRequestMethod("POST");
+        conn.setRequestProperty("Content-Type", "application/json");
+        conn.setConnectTimeout(15_000);
+        conn.setReadTimeout(15_000);
+        conn.setDoOutput(true);
+        try (OutputStream os = conn.getOutputStream()) {
+            os.write(body.toString().getBytes(StandardCharsets.UTF_8));
+        }
+        int code = conn.getResponseCode();
+        InputStream in = code >= 400 ? conn.getErrorStream() : conn.getInputStream();
+        String text = readAll(in);
+        if (code >= 400) {
+            String reason = new JSONObject(text).optString("reason", "http_" + code);
+            throw new IllegalStateException(reason);
+        }
+        return new JSONObject(text);
+    }
+
+    private static String readAll(InputStream in) throws Exception {
+        StringBuilder sb = new StringBuilder();
+        try (BufferedReader reader = new BufferedReader(
+                new InputStreamReader(in, StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                sb.append(line);
+            }
+        }
+        return sb.toString();
+    }
+
+    private static byte[] hexToBytes(String hex) {
+        byte[] out = new byte[hex.length() / 2];
+        for (int i = 0; i < out.length; i++) {
+            out[i] = (byte) Integer.parseInt(hex.substring(2 * i, 2 * i + 2), 16);
+        }
+        return out;
+    }
+}
diff --git a/src/com/android/settings/security/MaosAttestationFragment.java b/src/com/android/settings/security/MaosAttestationFragment.java
new file mode 100644
index 00000000000..3499350ea03
--- /dev/null
+++ b/src/com/android/settings/security/MaosAttestationFragment.java
@@ -0,0 +1,160 @@
+/*
+ * MAOS "Device attestation" settings page (one-time, the Auditor model).
+ *
+ * Deliberately minimal: a status line (the last server verdict, stored
+ * from the server's response), a single "Verify" action, and — once a
+ * verification has completed — the code and URL for viewing that one
+ * result at maproj.org/attest. There is no periodic or on-boot
+ * verification, no enrollment, and no background work of any kind.
+ */
+package com.android.settings.security;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Bundle;
+
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.dashboard.DashboardFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+
+import java.text.DateFormat;
+import java.util.Date;
+import java.util.concurrent.Executors;
+
+@SearchIndexable
+public class MaosAttestationFragment extends DashboardFragment {
+
+    private static final String TAG = "MaosAttestation";
+    private static final String KEY_STATUS = "maos_attestation_status";
+    private static final String KEY_VERIFY = "maos_attestation_verify";
+    private static final String KEY_RESULT = "maos_attestation_result";
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.SECURITY;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return TAG;
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.maos_attestation_settings;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        updateStatus();
+    }
+
+    @Override
+    public boolean onPreferenceTreeClick(Preference preference) {
+        if (KEY_VERIFY.equals(preference.getKey())) {
+            runVerify(preference);
+            return true;
+        }
+        if (KEY_RESULT.equals(preference.getKey())) {
+            openVerification();
+            return true;
+        }
+        return super.onPreferenceTreeClick(preference);
+    }
+
+    private void openVerification() {
+        Context context = getContext();
+        if (context == null) {
+            return;
+        }
+        SharedPreferences prefs = context.getSharedPreferences(
+                MaosAttestationClient.PREFS, Context.MODE_PRIVATE);
+        String url = prefs.getString(MaosAttestationClient.KEY_LAST_URL, null);
+        if (url == null || url.isEmpty()) {
+            return;
+        }
+        Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse(url));
+        try {
+            startActivity(intent);
+        } catch (Exception e) {
+            // No browser to open it with: the code and URL stay readable
+            // on this screen, which is the point of showing them.
+        }
+    }
+
+    private void runVerify(Preference verifyPref) {
+        Context context = getContext();
+        if (context == null) {
+            return;
+        }
+        verifyPref.setEnabled(false);
+        verifyPref.setSummary(R.string.maos_attestation_verifying);
+        Executors.newSingleThreadExecutor().execute(() -> {
+            String message;
+            try {
+                MaosAttestationClient.Result result =
+                        new MaosAttestationClient(context).verifyNow();
+                message = result.pass
+                        ? getString(R.string.maos_attestation_passed)
+                        : getString(R.string.maos_attestation_failed, result.reason);
+            } catch (Exception e) {
+                message = getString(R.string.maos_attestation_failed,
+                        String.valueOf(e.getMessage()));
+            }
+            String done = message;
+            if (getActivity() != null) {
+                getActivity().runOnUiThread(() -> {
+                    verifyPref.setEnabled(true);
+                    verifyPref.setSummary(done);
+                    updateStatus();
+                });
+            }
+        });
+    }
+
+    private void updateStatus() {
+        Preference status = findPreference(KEY_STATUS);
+        Context context = getContext();
+        if (status == null || context == null) {
+            return;
+        }
+        SharedPreferences prefs = context.getSharedPreferences(
+                MaosAttestationClient.PREFS, Context.MODE_PRIVATE);
+        String result = prefs.getString(MaosAttestationClient.KEY_LAST_RESULT, null);
+        if (result == null) {
+            status.setSummary(R.string.maos_attestation_never);
+        } else {
+            long at = prefs.getLong(MaosAttestationClient.KEY_LAST_AT, 0);
+            String level = prefs.getString(MaosAttestationClient.KEY_LAST_LEVEL, "");
+            String when = at == 0 ? "" : DateFormat.getDateTimeInstance().format(new Date(at));
+            status.setSummary(getString(R.string.maos_attestation_last, result, level, when));
+        }
+        Preference verification = findPreference(KEY_RESULT);
+        if (verification != null) {
+            String code = prefs.getString(MaosAttestationClient.KEY_LAST_CODE, null);
+            String url = prefs.getString(MaosAttestationClient.KEY_LAST_URL, null);
+            if (code == null || code.isEmpty() || url == null || url.isEmpty()) {
+                verification.setVisible(false);
+            } else {
+                verification.setVisible(true);
+                verification.setSummary(
+                        getString(R.string.maos_attestation_result_summary, code, url));
+            }
+        }
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.maos_attestation_settings);
+}
