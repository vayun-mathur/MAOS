+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  MAOS device attestation (Auditor, shape 3): server-verified status and a
+  single user-triggered "Verify" action. No periodic verification.
+  -->
+<PreferenceScreen
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:key="maos_attestation_settings"
+    android:title="@string/maos_attestation_title">
+
+    <Preference
+        android:key="maos_attestation_status"
+        android:title="@string/maos_attestation_status_title"
+        android:summary="@string/maos_attestation_never"
+        android:selectable="false" />
+
+    <Preference
+        android:key="maos_attestation_verify"
+        android:title="@string/maos_attestation_verify_title"
+        android:summary="@string/maos_attestation_verify_summary" />
+
+    <Preference
+        android:key="maos_attestation_result"
+        android:title="@string/maos_attestation_result_title" />
+
+    <Preference
+        android:key="maos_attestation_about"
+        android:title="@string/maos_attestation_about_title"
+        android:summary="@string/maos_attestation_about_summary"
+        android:selectable="false" />
+
+</PreferenceScreen>
