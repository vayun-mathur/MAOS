+        if (mCamera != null) {
+            mCamera.stop();
+            mCamera = null;
+        }
+        Bundle result = new Bundle();
+        result.putString(RESULT_CODE, parseSessionCode(qrCode));
+        getParentFragmentManager().setFragmentResult(RESULT_KEY, result);
+        getParentFragmentManager().popBackStack();
+    }
