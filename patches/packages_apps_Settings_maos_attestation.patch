+    /** Session code from `maos-attest://verify?code=XXXX-XXXX`, a bare
+     * code, or any URL carrying `code=` / `sessionCode=`. */
+    static String parseSessionCode(String qr) {
+        if (qr == null) {
+            return null;
+        }
+        String s = qr.trim();
+        for (String key : new String[]{"code=", "sessionCode="}) {
+            int at = s.indexOf(key);
+            if (at >= 0) {
+                String rest = s.substring(at + key.length());
+                StringBuilder out = new StringBuilder();
+                for (int i = 0; i < rest.length(); i++) {
+                    char c = rest.charAt(i);
+                    if (c == '&' || Character.isWhitespace(c) || c == '"' || c == '\'') {
+                        break;
+                    }
+                    out.append(c);
+                }
+                return out.toString();
+            }
+        }
+        return s;
+    }
+
+    @Override
+    public boolean isValid(String qrCode) {
+        String code = parseSessionCode(qrCode);
+        if (code == null || code.replace("-", "").length() != 8) {
+            mErrorMessage.setText(R.string.maos_attestation_scan_invalid);
+            mErrorMessage.setVisibility(View.VISIBLE);
+            return false;
+        }
+        return true;
+    }
