+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  MAOS Private DNS preset. Kept in its own values file so the MA DNS patch
+  does not have to share strings.xml / strings_ext.xml hunks with the other
+  Settings patches applied before it.
+  -->
+<resources>
+    <string name="private_dns_mode_ma_dns">MA DNS</string>
+</resources>
